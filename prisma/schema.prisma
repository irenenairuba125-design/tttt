generator client {
  provider = "prisma-client-js"
}

// NOTE: using SQLite for zero-setup local dev (no Postgres/Docker on this
// machine). SQLite doesn't support native enums or array columns, so those
// become plain String / Json fields here, validated at the API layer.
// For production, switch provider back to "postgresql" and this file's
// enum/array declarations can be restored (see git history / PR description).
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model University {
  id          String   @id @default(cuid())
  name        String
  mainLat     Float    @map("main_lat")
  mainLng     Float    @map("main_lng")
  district    String
  createdAt   DateTime @default(now()) @map("created_at")

  hostels     Hostel[]
  searchLogs  SearchLog[]

  @@map("universities")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String   @map("password_hash")
  role         String   @default("student") // super_admin | hostel_owner | student
  gender       String?  // male | female | other
  createdAt    DateTime @default(now()) @map("created_at")

  ownedHostels Hostel[]  @relation("HostelOwner")
  bookings     Booking[]
  payments     Payment[]
  reviews      Review[]
  searchLogs   SearchLog[]

  @@map("users")
}

model Hostel {
  id                String   @id @default(cuid())
  ownerId           String   @map("owner_id")
  universityId      String   @map("university_id")
  hostelName        String   @map("hostel_name")
  type              String   // girls_only | boys_only | mixed
  locationLat       Float    @map("location_lat")
  locationLng       Float    @map("location_lng")
  distanceFromGateM Int?     @map("distance_from_gate_m")
  addressText       String?  @map("address_text")
  description       String?
  rules             String?
  caretakerPhone    String   @map("caretaker_phone")
  priceRangeMin     Int      @map("price_range_min")
  priceRangeMax     Int      @map("price_range_max")
  rating            Float    @default(0)
  status            String   @default("pending") // pending | approved | rejected
  photos            Json     @default("[]")
  createdAt         DateTime @default(now()) @map("created_at")

  owner        User             @relation("HostelOwner", fields: [ownerId], references: [id])
  university   University       @relation(fields: [universityId], references: [id])
  rooms        Room[]
  bookings     Booking[]
  amenities    HostelAmenity[]
  reviews      Review[]

  @@map("hostels")
}

model Room {
  id               String   @id @default(cuid())
  hostelId         String   @map("hostel_id")
  roomNo           String   @map("room_no")
  roomType         String   @map("room_type") // single | double | triple
  floor            Int?
  pricePerSemester Int?     @map("price_per_semester")
  pricePerMonth    Int?     @map("price_per_month")
  totalBeds        Int      @map("total_beds")
  bedsAvailable    Int      @map("beds_available")
  amenities        Json     @default("[]")
  status           String   @default("available") // available | full | reserved
  createdAt        DateTime @default(now()) @map("created_at")

  hostel   Hostel    @relation(fields: [hostelId], references: [id])
  bookings Booking[]

  @@map("rooms")
}

model Booking {
  id               String    @id @default(cuid())
  studentId        String    @map("student_id")
  roomId           String    @map("room_id")
  hostelId         String    @map("hostel_id")
  bookingDate      DateTime  @default(now()) @map("booking_date")
  checkInDate      DateTime? @map("check_in_date")
  status           String    @default("pending") // pending|paid|reserved|checked_in|checked_out|cancelled|expired
  bookingFeeAmount Int       @map("booking_fee_amount")
  reservedUntil    DateTime? @map("reserved_until")
  createdAt        DateTime  @default(now()) @map("created_at")

  student  User      @relation(fields: [studentId], references: [id])
  room     Room      @relation(fields: [roomId], references: [id])
  hostel   Hostel    @relation(fields: [hostelId], references: [id])
  payments Payment[]

  @@map("bookings")
}

model Payment {
  id          String   @id @default(cuid())
  bookingId   String   @map("booking_id")
  studentId   String   @map("student_id")
  amount      Int
  momoTxnId   String?  @map("momo_txn_id")
  provider    String   @default("MTN") // MTN | Airtel
  status      String   @default("pending") // pending | success | failed
  paymentType String   @default("booking_fee") @map("payment_type") // booking_fee | rent
  createdAt   DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id])
  student User    @relation(fields: [studentId], references: [id])

  @@map("payments")
}

model Amenity {
  id   String @id @default(cuid())
  name String @unique

  hostels HostelAmenity[]

  @@map("amenities")
}

model HostelAmenity {
  hostelId  String @map("hostel_id")
  amenityId String @map("amenity_id")

  hostel  Hostel  @relation(fields: [hostelId], references: [id])
  amenity Amenity @relation(fields: [amenityId], references: [id])

  @@id([hostelId, amenityId])
  @@map("hostel_amenity")
}

model Review {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  hostelId  String   @map("hostel_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  student User   @relation(fields: [studentId], references: [id])
  hostel  Hostel @relation(fields: [hostelId], references: [id])

  @@map("reviews")
}

model SearchLog {
  id           String   @id @default(cuid())
  studentId    String?  @map("student_id")
  universityId String?  @map("university_id")
  filterType   String?  @map("filter_type")
  createdAt    DateTime @default(now()) @map("created_at")

  student    User?       @relation(fields: [studentId], references: [id])
  university University? @relation(fields: [universityId], references: [id])

  @@map("search_logs")
}
